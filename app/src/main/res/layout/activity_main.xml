<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:title="@string/app_name"
        app:titleTextColor="@android:color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Create tab -->
        <ScrollView
            android:id="@+id/create_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:background="@drawable/hero_bg"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_title"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hero_sub"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/create_cutout"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#EADDFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_cutout"
                                app:tint="@color/brand" />
                            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_cutout"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="#1D1B20"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_cutout_sub"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="#49454F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/create_text"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#FFD9E2">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_text"
                                app:tint="@color/brand" />
                            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_text"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="#1D1B20"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_text_sub"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="#49454F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/create_media"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#FFE8B8">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_video"
                                app:tint="@color/brand" />
                            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_media"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="#1D1B20"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_media_sub"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="#49454F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/create_photo"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="24dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="#D3F2E6">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_photo"
                                app:tint="@color/brand" />
                            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_photo"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="#1D1B20"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_photo_sub"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="#49454F" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="@string/create_tip"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </ScrollView>

        <!-- Explore tab -->
        <LinearLayout
            android:id="@+id/explore_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/packs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
                <TextView
                    android:id="@+id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/search_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- My Stickers tab -->
        <FrameLayout
            android:id="@+id/mine_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mine"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />
            <LinearLayout
                android:id="@+id/mine_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mine"
                    app:tint="@color/brand" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/mine_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mine_make"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/mine_empty_button" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mine_import"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/import_pack" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
